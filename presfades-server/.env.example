# Database
DATABASE_URL=postgresql://user:password@host:5432/presfades

# Twilio credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Provide either a messaging service SID or a phone number
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_FROM_NUMBER=+15558675309

# AWS credentials for S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-west-2
S3_BUCKET=presfades-leads

# Application configuration
PUBLIC_BASE_URL=https://example.com
PORT=10000
UPLOAD_TOKEN_SECRET=super_secret_token_value

# Optional Turnstile secret for verifying tokens
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
