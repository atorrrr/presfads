# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/presfads

# Required: Upload Security Token
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_TOKEN_SECRET=your_secret_here

# Twilio Configuration (Required for SMS features)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Provide either TWILIO_MESSAGING_SERVICE_SID or TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_FROM_NUMBER=+15558675309

# AWS S3 Configuration (Required for file uploads)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-west-2
S3_BUCKET=presfads-leads

# Application Configuration (Optional)
PUBLIC_BASE_URL=https://your-app.onrender.com
PORT=5000

# Cloudflare Turnstile (Optional - for bot protection)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
